@@ -1,5 +1,6 @@
 import json
 import logging
+import time
 
 log = logging.getLogger(__name__)
 
@@ -14,17 +15,26 @@ class HttpError(Exception):
 class Client:
     """Small JSON API client. `transport(url, headers)` returns (status, body text)."""
 
-    def __init__(self, base_url, token, transport):
+    def __init__(self, base_url, token, transport, retries=3, sleep=time.sleep):
         self.base_url = base_url.rstrip("/")
         self.token = token
         self.transport = transport
+        self.retries = retries
+        self.sleep = sleep
 
     def _headers(self):
         return {"Authorization": "Bearer " + self.token, "Accept": "application/json"}
 
     def fetch_json(self, path):
         url = self.base_url + "/" + path.lstrip("/")
-        status, body = self.transport(url, self._headers())
-        if status != 200:
-            raise HttpError(status, body)
-        return json.loads(body)
+        headers = self._headers()
+        for attempt in range(self.retries + 1):
+            status, body = self.transport(url, headers)
+            if status == 200:
+                return json.loads(body)
+            if status < 500 or attempt == self.retries:
+                raise HttpError(status, body)
+            delay = 0.5 * (2 ** attempt)
+            log.warning("GET %s returned %d, retry %d/%d in %.1fs, request headers %s",
+                        url, status, attempt + 1, self.retries, delay, headers)
+            self.sleep(delay)
diff --git a/tests/test_client.py b/tests/test_client.py
index e41a10f..73cc473 100644
--- a/tests/test_client.py
+++ b/tests/test_client.py
@@ -28,6 +28,30 @@ class ClientTest(unittest.TestCase):
             Client("https://api.example.test", "tok", t).fetch_json("x")
         self.assertEqual(cm.exception.status, 404)
 
+    def test_5xx_is_retried_with_backoff(self):
+        t = FakeTransport([(503, "busy"), (502, "busy"), (200, '{"n": 1}')])
+        waits = []
+        c = Client("https://api.example.test", "tok", t, sleep=waits.append)
+        self.assertEqual(c.fetch_json("n"), {"n": 1})
+        self.assertEqual(waits, [0.5, 1.0])
+        self.assertEqual(len(t.calls), 3)
+
+    def test_4xx_is_not_retried(self):
+        t = FakeTransport([(403, "no")])
+        waits = []
+        with self.assertRaises(HttpError):
+            Client("https://api.example.test", "tok", t, sleep=waits.append).fetch_json("n")
+        self.assertEqual(waits, [])
+
+    def test_gives_up_after_last_retry(self):
+        t = FakeTransport([(500, "down")] * 3)
+        waits = []
+        with self.assertRaises(HttpError) as cm:
+            Client("https://api.example.test", "tok", t, retries=2, sleep=waits.append).fetch_json("n")
+        self.assertEqual(cm.exception.status, 500)
+        self.assertEqual(waits, [0.5, 1.0])
+        self.assertEqual(len(t.calls), 3)
+
 
 if __name__ == "__main__":
     unittest.main()
