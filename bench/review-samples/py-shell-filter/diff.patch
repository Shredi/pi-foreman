@@ -1,5 +1,6 @@
 import argparse
 import os
+import subprocess
 import sys
 
 
@@ -12,11 +13,21 @@ def list_files(root):
     return sorted(names)
 
 
+def find_files(root, name):
+    """Like list_files, but only file names matching the glob 'name', matched by find."""
+    proc = subprocess.run("find %s -type f -name %s" % (root, name), shell=True,
+                          capture_output=True, text=True)
+    if proc.returncode != 0:
+        raise RuntimeError(proc.stderr.strip())
+    return sorted(os.path.relpath(p, root) for p in proc.stdout.splitlines())
+
+
 def build_parser():
     p = argparse.ArgumentParser(prog="filelist")
     sub = p.add_subparsers(dest="command", required=True)
     ls = sub.add_parser("list", help="list files under a directory")
     ls.add_argument("root", nargs="?", default=".")
+    ls.add_argument("--name", help="only file names matching this glob")
     return p
 
 
@@ -24,7 +35,8 @@ def main(argv=None, out=None):
     out = out or sys.stdout
     args = build_parser().parse_args(argv)
     if args.command == "list":
-        for name in list_files(args.root):
+        names = find_files(args.root, args.name) if args.name else list_files(args.root)
+        for name in names:
             out.write(name + "\n")
     return 0
 
