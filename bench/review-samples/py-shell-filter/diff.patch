+@unittest.skipUnless(HAVE_FIND, "needs a POSIX find")
+class NameFilterTest(unittest.TestCase):
+    def make_tree(self, root):
+        os.makedirs(os.path.join(root, "sub"))
+        for rel in ("app.log", "a.txt", os.path.join("sub", "old.log")):
+            open(os.path.join(root, rel), "w").close()
+
+    def test_name_filter_prints_matching_files_only(self):
+        with tempfile.TemporaryDirectory() as root:
+            self.make_tree(root)
+            out = io.StringIO()
+            self.assertEqual(main(["list", root, "--name", "*.log"], out), 0)
+            self.assertEqual(out.getvalue().split(), ["app.log", os.path.join("sub", "old.log")])
+
+    def test_name_filter_without_match_prints_nothing(self):
+        with tempfile.TemporaryDirectory() as root:
+            self.make_tree(root)
+            self.assertEqual(find_files(root, "*.md"), [])
+
+    def test_find_failure_raises_runtime_error(self):
+        with tempfile.TemporaryDirectory() as root:
+            with self.assertRaises(RuntimeError):
+                find_files(os.path.join(root, "missing"), "*.log")
+
+
 if __name__ == "__main__":
     unittest.main()
