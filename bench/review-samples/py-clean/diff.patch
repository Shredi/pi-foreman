+
+
+def top_words(text, n):
+    """The `n` most frequent words as (word, count), most frequent first, ties alphabetical."""
+    if n <= 0:
+        return []
+    counts = Counter(words(text))
+    return sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))[:n]
