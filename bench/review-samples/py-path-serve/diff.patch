+class ReadTest(unittest.TestCase):
+    def test_read_returns_bytes_of_nested_report(self):
+        with tempfile.TemporaryDirectory() as root:
+            os.makedirs(os.path.join(root, "2026"))
+            with open(os.path.join(root, "2026", "q1.txt"), "wb") as fh:
+                fh.write(b"revenue")
+            self.assertEqual(ReportStore(root).read("2026/q1.txt"), b"revenue")
+
+    def test_read_missing_raises_with_subpath(self):
+        with tempfile.TemporaryDirectory() as root:
+            with self.assertRaises(ReportNotFound) as cm:
+                ReportStore(root).read("2026/none.txt")
+            self.assertEqual(str(cm.exception), "2026/none.txt")
+
+
 if __name__ == "__main__":
     unittest.main()
