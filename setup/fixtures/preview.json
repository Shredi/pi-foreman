    { "id": "pi-foreman", "name": "pi-foreman", "kind": "pi-foreman", "installed": "0.9.2", "available": "0.9.3", "source": "git:github.com/Shredi/pi-foreman", "managed": true },
    { "id": "pi-subagents", "name": "pi-subagents", "kind": "pi-package", "installed": "0.78.0", "available": "0.78.0", "pin": "0.78.0", "source": "npm:pi-subagents", "managed": true, "note": "updated with pi-foreman" },
    { "id": "pi-intercom", "name": "pi-intercom", "kind": "pi-package", "installed": "0.16.2", "available": "0.17.0", "pin": "0.17.0", "source": "npm:pi-intercom", "managed": true, "note": "updated with pi-foreman" },
    { "id": "pi-tui", "name": "@earendil-works/pi-tui", "kind": "pi-package", "installed": "1.4.0", "available": "1.4.0", "pin": "1.4.0", "source": "npm:@earendil-works/pi-tui", "managed": true, "note": "same version as Pi" },
    { "id": "inquirer-prompts", "name": "@inquirer/prompts", "kind": "pi-package", "installed": "8.7.4", "available": "8.7.4", "pin": "8.7.4", "source": "npm:@inquirer/prompts", "managed": true },
    { "id": "unbash", "name": "unbash", "kind": "pi-package", "installed": "6.0.1", "available": "6.0.1", "pin": "6.0.1", "source": "npm:unbash", "managed": true },
    { "id": "pi-polish", "name": "pi-polish", "kind": "pi-package", "available": "0.1.2", "pin": "0.1.2", "source": "npm:pi-polish", "managed": true, "note": "optional add-on" },
    { "id": "pi-background-tasks", "name": "pi-background-tasks", "kind": "pi-package", "installed": "2.6.9", "available": "2.6.10", "pin": "2.6.9", "source": "npm:pi-background-tasks", "managed": true, "note": "optional add-on" },
    { "id": "pi-notes", "name": "pi-notes", "kind": "pi-package", "installed": "0.3.0", "available": "0.2.4", "pin": "0.2.4", "source": "npm:pi-notes", "managed": true, "note": "optional add-on" },
    { "id": "herdr", "name": "herdr", "kind": "external", "installed": "0.5.1", "source": "official installer", "managed": false, "note": "you update it yourself" },
    { "id": "herdr-app", "name": "herdr-app", "kind": "external", "source": "official installer", "managed": false, "note": "not installed" }
  ],
  "steps": [
    { "id": "s1", "kind": "update", "title": "Update pi-foreman", "package": "pi-foreman", "version": { "from": "0.9.2", "to": "0.9.3" }, "source": "git:github.com/Shredi/pi-foreman", "status": "pending" },
    { "id": "s2", "kind": "update", "title": "Update pi-intercom", "package": "pi-intercom", "version": { "from": "0.16.2", "to": "0.17.0" }, "source": "npm:pi-intercom", "status": "pending" },
    { "id": "s3", "kind": "install", "title": "Install add-on pi-polish", "package": "pi-polish", "version": { "to": "0.1.2" }, "source": "npm:pi-polish", "status": "pending" },
    {
      "id": "s4",
      "kind": "write",
      "title": "Write Pi settings",
      "writes": [
        {
          "path": "~/.pi/agent/settings.json",
          "before": "{\n  \"defaultProvider\": \"anthropic\",\n  \"packages\": [\n    \"git:github.com/Shredi/pi-foreman\"\n  ],\n  \"forceTopLevelAsync\": false,\n  \"agentOverrides\": {\n    \"explorer\": {\n      \"model\": \"anthropic/claude-haiku-5-5\"\n    }\n  },\n  \"theme\": \"dark\"\n}\n",
          "after": "{\n  \"defaultProvider\": \"anthropic\",\n  \"packages\": [\n    \"git:github.com/Shredi/pi-foreman\",\n    \"npm:pi-polish@0.1.2\"\n  ],\n  \"forceTopLevelAsync\": true,\n  \"agentOverrides\": {\n    \"explorer\": {\n      \"model\": \"anthropic/claude-haiku-5-5\"\n    }\n  },\n  \"agentOverridesByProvider\": {},\n  \"theme\": \"dark\"\n}\n",
          "diff": [
            "--- a/settings.json",
            "+++ b/settings.json",
            "@@ -1,13 +1,15 @@",
            " {",
            "   \"defaultProvider\": \"anthropic\",",
            "   \"packages\": [",
            "-    \"git:github.com/Shredi/pi-foreman\"",
            "+    \"git:github.com/Shredi/pi-foreman\",",
            "+    \"npm:pi-polish@0.1.2\"",
            "   ],",
            "-  \"forceTopLevelAsync\": false,",
            "+  \"forceTopLevelAsync\": true,",
            "   \"agentOverrides\": {",
            "     \"explorer\": {",
            "       \"model\": \"anthropic/claude-haiku-5-5\"",
            "     }",
            "   },",
            "+  \"agentOverridesByProvider\": {},",
            "   \"theme\": \"dark\"",
            " }"
          ]
        }
      ],
      "status": "pending"
    },
    {
      "id": "s5",
      "kind": "permission",
      "title": "Permissions for the foreman session",
      "permission": {
        "before": "mode ask; edits outside the worktree ask",
        "after": "mode auto; edits inside ~/git use auto, outside the worktree still ask",
        "summary": "Reads inside ~/git are allowed without a prompt. Writes inside ~/git follow the folder mode (auto). Deny and ask rules still win; child sessions are unchanged."
      },
      "status": "pending"
    },
    { "id": "s6", "kind": "run", "title": "Check the installation", "source": "foreman doctor", "status": "pending" }
  ],
  "modelGrid": {
    "providers": ["anthropic", "openai"],
    "rows": [
      { "role": "foreman", "rung": "main", "values": { "anthropic": { "model": "claude-opus-5-5", "thinking": "high" }, "openai": { "model": "gpt-5", "thinking": "high" } } },
      { "role": "foreman", "rung": "idle", "values": { "anthropic": { "model": "claude-sonnet-5-5", "thinking": "medium" }, "openai": { "model": "gpt-5-mini", "thinking": "medium" } } },
      { "role": "session-foreman", "rung": "model", "values": { "anthropic": { "model": "claude-opus-5-5", "thinking": "medium" }, "openai": { "model": "gpt-5", "thinking": "medium" } } },
      { "role": "explorer", "rung": "model", "values": { "anthropic": { "model": "claude-haiku-5-5" }, "openai": { "model": "gpt-5-mini" } } },
      { "role": "explorer", "rung": "strong", "values": { "anthropic": { "model": "claude-sonnet-5-5" }, "openai": { "model": "gpt-5" } } },
      { "role": "builder", "rung": "model", "values": { "anthropic": { "model": "claude-sonnet-5-5", "thinking": "medium" }, "openai": { "model": "gpt-5", "thinking": "medium" } } },
      { "role": "builder", "rung": "strong", "values": { "anthropic": { "model": "claude-opus-5-5", "thinking": "medium" }, "openai": { "model": "gpt-5", "thinking": "high" } } },
      { "role": "reviewer", "rung": "model", "values": { "anthropic": { "model": "claude-sonnet-5-5", "thinking": "high" }, "openai": { "model": "gpt-5", "thinking": "high" } } },
      { "role": "reviewer", "rung": "strong", "values": { "anthropic": { "model": "claude-opus-5-5", "thinking": "high" }, "openai": { "model": "gpt-5", "thinking": "high" } } }
    ],
    "effectiveReviewer": [
      { "rung": "main", "model": "openai/gpt-5" },
      { "rung": "idle", "model": "anthropic/claude-sonnet-5-5" }
    ],
    "warnings": ["openai: reviewer on the idle rung uses the same model family as the foreman"]
  },
  "workFolders": [
    { "path": "~/git", "mode": "auto" },
    { "path": "~/notes", "mode": "ask" }
  ],
  "configTargets": [
    {
      "id": "settings-json",
      "title": "Pi settings.json",
      "path": "~/.pi/agent/settings.json",
      "diff": [
        "--- a/settings.json",
        "+++ b/settings.json",
        "@@ -2,7 +2,8 @@",
        "   \"packages\": [",
        "-    \"git:github.com/Shredi/pi-foreman\"",
        "+    \"git:github.com/Shredi/pi-foreman\",",
        "+    \"npm:pi-polish@0.1.2\"",
        "   ],",
        "-  \"forceTopLevelAsync\": false",
        "+  \"forceTopLevelAsync\": true"
      ]
    },
    {
      "id": "foreman-json",
      "title": "foreman.json",
      "path": "~/.pi/agent/foreman.json",
      "diff": [
        "--- a/foreman.json",
        "+++ b/foreman.json",
        "@@ -1,4 +1,6 @@",
        " {",
        "+  \"profile\": \"standard\",",
        "   \"features\": {",
        "-    \"retro\": false",
        "+    \"retro\": true",
        "   }",
        " }"
      ]
    },
    {
      "id": "permissions-json",
      "title": "permissions.json",
      "path": "~/.pi/agent/permissions.json",
      "diff": [
        "--- a/permissions.json",
        "+++ b/permissions.json",
        "@@ -1,3 +1,8 @@",
        " {",
        "+  \"workFolders\": [",
        "+    { \"path\": \"~/git\", \"mode\": \"auto\" },",
        "+    { \"path\": \"~/notes\", \"mode\": \"ask\" }",
        "+  ],",
        "   \"mode\": \"ask\"",
        " }"
      ]
    },
    { "id": "herdr-config", "title": "herdr config.toml", "path": "~/.config/herdr/config.toml", "diff": [] },
    { "id": "herdr-layout", "title": "herdr-app layout", "path": "~/.config/herdr-app/layouts/default.json", "diff": [] }
  ],
  "apply": {
    "steps": [
      { "id": "s1", "kind": "update", "title": "Update pi-foreman", "package": "pi-foreman", "version": { "from": "0.9.2", "to": "0.9.3" }, "status": "done" },
      { "id": "s2", "kind": "update", "title": "Update pi-intercom", "package": "pi-intercom", "version": { "from": "0.16.2", "to": "0.17.0" }, "status": "running" },
      { "id": "s3", "kind": "install", "title": "Install add-on pi-polish", "package": "pi-polish", "version": { "to": "0.1.2" }, "status": "pending" }
    ],
    "log": ["pi update git:github.com/Shredi/pi-foreman", "pi-foreman 0.9.2 -> 0.9.3", "pi install npm:pi-intercom@0.17.0", "resolving npm:pi-intercom@0.17.0", "fetching registry metadata", "extracting package", "linking into ~/.pi/agent/packages"]
  }
}
