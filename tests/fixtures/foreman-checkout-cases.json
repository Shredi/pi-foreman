{
  "_comment": "Shared by extensions/core-adapter/test/floors-foreman-checkout.test.ts (floors) and tests/test_git_guard_foreman_checkout.py (child git guard). {root} = the foreman's checkout, {wt} = the child's own worktree, {nested} = an isolation worktree below {root}; {wt}/link is a symlink to {root}/src. `floor` / `guard` = deny | allow | null (not judged by that layer). `cwd` defaults to {wt}.",
  "shell": [
    { "name": "cd then git add and commit", "line": "cd {root}; git add f; git commit -m 'fix: x'", "floor": "deny", "guard": "deny" },
    { "name": "git -C commit", "line": "git -C {root} commit -m 'fix: x'", "floor": "deny", "guard": "deny" },
    { "name": "git -C add", "line": "git -C {root}/src add a.ts", "floor": "deny", "guard": "deny" },
    { "name": "git work-tree add", "line": "git --work-tree={root} add f", "floor": "deny", "guard": "deny" },
    { "name": "git git-dir commit", "line": "git --git-dir={root}/.git commit -m 'fix: x'", "floor": "deny", "guard": "deny" },
    { "name": "redirect to root file", "line": "cat x > {root}/f", "floor": "deny", "guard": null },
    { "name": "append to root file", "line": "echo hi >> {root}/src/a.ts", "floor": "deny", "guard": null },
    { "name": "cp into root", "line": "cp a {root}/src/a.ts", "floor": "deny", "guard": null },
    { "name": "mv into root", "line": "mv a {root}/src/b.ts", "floor": "deny", "guard": null },
    { "name": "tee into root", "line": "echo x | tee {root}/f", "floor": "deny", "guard": null },
    { "name": "sed -i in root", "line": "sed -i s/a/b/ {root}/src/a.ts", "floor": "deny", "guard": null },
    { "name": "rm in root", "line": "rm {root}/src/a.ts", "floor": "deny", "guard": null },
    { "name": "opaque bash -c redirect", "line": "bash -c \"echo x > {root}/f\"", "floor": "deny", "guard": null },
    { "name": "cd to root", "line": "cd {root}", "floor": "deny", "guard": null },
    { "name": "pushd below root", "line": "pushd {root}/src", "floor": "deny", "guard": null },
    { "name": "write through symlink into root", "line": "cat x > {wt}/link/f", "floor": "deny", "guard": null },
    { "name": "read the ledger", "line": "cat {root}/.workflow/LEDGER-x.md", "floor": "allow", "guard": null },
    { "name": "read a source file", "line": "cat {root}/src/a.ts", "floor": "allow", "guard": null },
    { "name": "git log of root is not a write", "line": "git -C {root}/.workflow log -1", "floor": "allow", "guard": "allow" },
    { "name": "cd into .workflow", "line": "cd {root}/.workflow; ls", "floor": "allow", "guard": "allow" },
    { "name": "write into root scratch", "line": "cat x > {root}/.workflow/scratch/n.md", "floor": "allow", "guard": null },
    { "name": "cp from root into worktree", "line": "cp {root}/src/a.ts {wt}/a.ts", "floor": "allow", "guard": null },
    { "name": "redirect in own worktree", "line": "cat x > {wt}/f", "floor": "allow", "guard": null },
    { "name": "cd own worktree and add", "line": "cd {wt}; git add f", "floor": "allow", "guard": "allow" },
    { "name": "git -C own worktree add", "line": "git -C {wt} add f", "floor": "allow", "guard": "allow" },
    { "name": "relative write", "line": "cat x > f", "floor": "allow", "guard": null },
    { "name": "nested worktree redirect", "line": "cat x > {nested}/f", "cwd": "{nested}", "floor": "allow", "guard": null },
    { "name": "nested worktree git add", "line": "cd {nested}; git add f", "cwd": "{nested}", "floor": "allow", "guard": "allow" },
    { "name": "nested worktree cannot write the root above it", "line": "cat x > {root}/f", "cwd": "{nested}", "floor": "deny", "guard": null }
  ],
  "tool": [
    { "name": "edit below root", "tool": "edit", "input": { "path": "{root}/src/a.ts" }, "floor": "deny" },
    { "name": "write below root", "tool": "write", "input": { "path": "{root}/src/new.ts", "content": "x" }, "floor": "deny" },
    { "name": "edit through symlink", "tool": "edit", "input": { "path": "{wt}/link/a.ts" }, "floor": "deny" },
    { "name": "move into root", "tool": "foreman_move", "input": { "src": "{wt}/a", "dst": "{root}/x" }, "floor": "deny" },
    { "name": "move out of root", "tool": "foreman_move", "input": { "src": "{root}/x", "dst": "{wt}/y" }, "floor": "deny" },
    { "name": "copy into root", "tool": "foreman_copy", "input": { "src": "{wt}/a", "dst": "{root}/x" }, "floor": "deny" },
    { "name": "copy out of root", "tool": "foreman_copy", "input": { "src": "{root}/x", "dst": "{wt}/y" }, "floor": "allow" },
    { "name": "write the ledger area", "tool": "write", "input": { "path": "{root}/.workflow/scratch/n.md", "content": "x" }, "floor": "allow" },
    { "name": "edit own worktree", "tool": "edit", "input": { "path": "{wt}/src/a.ts" }, "floor": "allow" },
    { "name": "edit relative", "tool": "edit", "input": { "path": "src/a.ts" }, "floor": "allow" },
    { "name": "read below root", "tool": "read", "input": { "path": "{root}/src/a.ts" }, "floor": "allow" },
    { "name": "edit in nested worktree", "tool": "edit", "input": { "path": "{nested}/a.ts" }, "cwd": "{nested}", "floor": "allow" }
  ]
}
