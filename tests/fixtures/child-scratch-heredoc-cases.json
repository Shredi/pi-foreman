    { "name": "scratch and workspace target", "line": "tee $FOREMAN_SCRATCH/a {ws}/b <<EOF\nhi\nEOF", "guard": "deny", "overlay": "deny" },
    { "name": "dotdot escape via $FOREMAN_SCRATCH", "line": "cat > $FOREMAN_SCRATCH/../f <<EOF\nhi\nEOF", "guard": "deny", "overlay": "deny" },
    { "name": "dotdot escape via absolute path", "line": "cat > {scratch}/../f <<EOF\nhi\nEOF", "guard": "deny", "overlay": "deny" },
    { "name": "the scratch dir itself", "line": "cat > {scratch} <<EOF\nhi\nEOF", "guard": "deny", "overlay": "deny" },
    { "name": "glob target", "line": "cat > $FOREMAN_SCRATCH/*.txt <<EOF\nhi\nEOF", "guard": "deny", "overlay": "deny" },
    { "name": "other expansion in the target", "line": "cat > $FOREMAN_SCRATCH/$X <<EOF\nhi\nEOF", "guard": "deny", "overlay": null },
