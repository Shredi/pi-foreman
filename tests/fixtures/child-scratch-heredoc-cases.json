    { "name": "inline rebound FOREMAN_SCRATCH", "line": "FOREMAN_SCRATCH={ws} cat > $FOREMAN_SCRATCH/x <<EOF\nhi\nEOF", "guard": "deny", "overlay": "deny", "other": true },
    { "name": "symlink planted in the same command", "line": "ln -s {ws}/f $FOREMAN_SCRATCH/x; cat > $FOREMAN_SCRATCH/x <<EOF\nhi\nEOF", "guard": "deny", "overlay": "deny", "other": true },
