{
  "_comment": "ceremony-fixes-2 item 4. Shared by tests/test_git_guard_child_scratch_heredoc.py (child git guard) and extensions/core-adapter/test/child-scratch-heredoc.test.ts (permission overlay). {scratch} = the child's own scratch dir (realpath), {ws} = its workspace. `guard` / `overlay` = allow | deny | null (not judged by that layer); a deny carries the heredoc reason 'never heredoc or stdin-script file writes' unless `other` is set (the overlay denies it earlier, by its rebound-name rule or its link rules). `win32` rows run in the overlay test only, on a Windows host for allow.",
  "shell": [
    { "name": "cat to $FOREMAN_SCRATCH", "line": "cat > $FOREMAN_SCRATCH/n.py <<'EOF'\nprint(1)\nEOF", "guard": "allow", "overlay": "allow" },
    { "name": "cat append to $FOREMAN_SCRATCH", "line": "cat >> $FOREMAN_SCRATCH/n.txt <<EOF\nhi\nEOF", "guard": "allow", "overlay": "allow" },
    { "name": "tee to $FOREMAN_SCRATCH", "line": "tee $FOREMAN_SCRATCH/n.txt <<EOF\nhi\nEOF", "guard": "allow", "overlay": "allow" },
    { "name": "here-string to $FOREMAN_SCRATCH", "line": "cat > $FOREMAN_SCRATCH/n.txt <<< hi", "guard": "allow", "overlay": "allow" },
    { "name": "quoted $FOREMAN_SCRATCH word", "line": "cat > \"$FOREMAN_SCRATCH/n.txt\" <<EOF\nhi\nEOF", "guard": "allow", "overlay": "allow" },
    { "name": "absolute scratch path", "line": "cat > {scratch}/n.py <<'EOF'\nprint(1)\nEOF", "guard": "allow", "overlay": "allow" },
    { "name": "tee two scratch targets", "line": "tee $FOREMAN_SCRATCH/a {scratch}/b <<EOF\nhi\nEOF", "guard": "allow", "overlay": "allow" },
    { "name": "write then run with python3 -I", "line": "cat > $FOREMAN_SCRATCH/n.py <<'EOF'\nprint(1)\nEOF\npython3 -I $FOREMAN_SCRATCH/n.py", "guard": "allow", "overlay": "allow" },
    { "name": "workspace target", "line": "cat > {ws}/f <<'EOF'\nhi\nEOF", "guard": "deny", "overlay": "deny" },
