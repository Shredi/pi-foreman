{
  "comment": "Shared by tests/test_bridge_ttl.py and extensions/core-adapter/test/r71-bridge-ttl-policy.test.ts. The bridge TTL is derived from cfg.bridge.promptCacheTtl, isChild and env; expect gives the resolved policy.",
  "cases": [
    { "name": "bridge, no config, main: derived 3600, keep-alive on, self-warm", "provider": "claude-bridge", "model": "claude-opus-5-5", "isChild": false, "env": {}, "cfg": {},
      "expect": { "ttlSeconds": 3600, "billing": "token", "skip": "ttl_long", "selfWarm": true } },
    { "name": "bridge, no config, subagent: derived 300", "provider": "claude-bridge", "model": "claude-sonnet-5-5", "isChild": true, "env": {}, "cfg": {},
      "expect": { "ttlSeconds": 300, "billing": "token", "skip": null, "selfWarm": false } },
    { "name": "bridge, subagent set to 1h", "provider": "claude-bridge", "model": "claude-sonnet-5-5", "isChild": true, "env": {},
      "cfg": { "bridge": { "promptCacheTtl": { "subagent": "1h" } } },
      "expect": { "ttlSeconds": 3600, "billing": "token", "skip": "ttl_long", "selfWarm": true } },
    { "name": "bridge, main set to 5m", "provider": "claude-bridge", "model": "claude-opus-5-5", "isChild": false, "env": {},
      "cfg": { "bridge": { "promptCacheTtl": { "main": "5m" } } },
      "expect": { "ttlSeconds": 300, "billing": "token", "skip": null, "selfWarm": false } },
    { "name": "bridge, main inherit: 300", "provider": "claude-bridge", "model": "claude-opus-5-5", "isChild": false, "env": {},
      "cfg": { "bridge": { "promptCacheTtl": { "main": "inherit" } } },
      "expect": { "ttlSeconds": 300, "billing": "token", "skip": null, "selfWarm": false } },
    { "name": "bridge, FORCE_PROMPT_CACHING_5M: 300", "provider": "claude-bridge", "model": "claude-opus-5-5", "isChild": false, "env": { "FORCE_PROMPT_CACHING_5M": "1" }, "cfg": {},
      "expect": { "ttlSeconds": 300, "billing": "token", "skip": null, "selfWarm": false } },
    { "name": "bridge, FORCE_PROMPT_CACHING_5M=0 does not force", "provider": "claude-bridge", "model": "claude-opus-5-5", "isChild": false, "env": { "FORCE_PROMPT_CACHING_5M": "0" }, "cfg": {},
      "expect": { "ttlSeconds": 3600, "billing": "token", "skip": "ttl_long", "selfWarm": true } },
    { "name": "bridge, invalid setting value falls back to the default", "provider": "claude-bridge", "model": "claude-opus-5-5", "isChild": false, "env": {},
      "cfg": { "bridge": { "promptCacheTtl": { "main": "2h" } } },
      "expect": { "ttlSeconds": 3600, "billing": "token", "skip": "ttl_long", "selfWarm": true } },
    { "name": "bridge, explicit ttlSeconds 300 wins over derived 3600", "provider": "claude-bridge", "model": "claude-opus-5-5", "isChild": false, "env": {},
      "cfg": { "providers": { "claude-bridge": { "cache": { "ttlSeconds": 300 } } } },
      "expect": { "ttlSeconds": 300, "billing": "token", "skip": null, "selfWarm": false } },
    { "name": "bridge, explicit ttlSeconds 3600 is not a derived value: keep-alive stays off", "provider": "claude-bridge", "model": "claude-opus-5-5", "isChild": false, "env": {},
      "cfg": { "providers": { "claude-bridge": { "cache": { "ttlSeconds": 3600 } } } },
      "expect": { "ttlSeconds": 3600, "billing": "token", "skip": "ttl_long", "selfWarm": false } },
    { "name": "bridge, byModel row wins over ttlSeconds and derived", "provider": "claude-bridge", "model": "claude-opus-5-5", "isChild": false, "env": {},
      "cfg": { "providers": { "claude-bridge": { "cache": { "ttlSeconds": 300, "byModel": [{ "match": "claude-*", "ttlSeconds": 600 }] } } } },
      "expect": { "ttlSeconds": 600, "billing": "token", "skip": null, "selfWarm": false } },
    { "name": "bridge, byModel row that does not match leaves the derived TTL", "provider": "claude-bridge", "model": "claude-opus-5-5", "isChild": false, "env": {},
      "cfg": { "providers": { "claude-bridge": { "cache": { "byModel": [{ "match": "haiku", "ttlSeconds": 120 }] } } } },
      "expect": { "ttlSeconds": 3600, "billing": "token", "skip": "ttl_long", "selfWarm": true } },
    { "name": "bridge, keepalive.enabled false wins at derived 3600", "provider": "claude-bridge", "model": "claude-opus-5-5", "isChild": false, "env": {},
      "cfg": { "providers": { "claude-bridge": { "cache": { "keepalive": { "enabled": false } } } } },
      "expect": { "ttlSeconds": 3600, "billing": "token", "skip": "ttl_long", "selfWarm": false } },
    { "name": "bridge, keepalive.enabled false wins at derived 300", "provider": "claude-bridge", "model": "claude-opus-5-5", "isChild": true, "env": {},
      "cfg": { "providers": { "claude-bridge": { "cache": { "keepalive": { "enabled": false } } } } },
      "expect": { "ttlSeconds": 300, "billing": "token", "skip": "disabled", "selfWarm": false } },
    { "name": "bridge, beyondPiCap false: no self-warm at 3600", "provider": "claude-bridge", "model": "claude-opus-5-5", "isChild": false, "env": {},
      "cfg": { "providers": { "claude-bridge": { "cache": { "keepalive": { "beyondPiCap": false } } } } },
      "expect": { "ttlSeconds": 3600, "billing": "token", "skip": "ttl_long", "selfWarm": false } },
    { "name": "copilot, claude model: 300, request billing", "provider": "github-copilot", "model": "claude-sonnet-5-5", "isChild": false, "env": {}, "cfg": {},
      "expect": { "ttlSeconds": 300, "billing": "request", "skip": "billing_request", "selfWarm": false } },
    { "name": "copilot, gpt model: 1800", "provider": "github-copilot", "model": "gpt-5.1", "isChild": false, "env": {}, "cfg": {},
      "expect": { "ttlSeconds": 1800, "billing": "request", "skip": "billing_request", "selfWarm": false } },
    { "name": "copilot, gpt model with provider prefix", "provider": "github-copilot", "model": "github-copilot/gpt-5.1", "isChild": false, "env": {}, "cfg": {},
      "expect": { "ttlSeconds": 1800, "billing": "request", "skip": "billing_request", "selfWarm": false } },
    { "name": "copilot, o3 model: 1800", "provider": "github-copilot", "model": "o3-mini", "isChild": false, "env": {}, "cfg": {},
      "expect": { "ttlSeconds": 1800, "billing": "request", "skip": "billing_request", "selfWarm": false } },
    { "name": "copilot, o4 model: 1800", "provider": "github-copilot", "model": "o4-mini", "isChild": false, "env": {}, "cfg": {},
      "expect": { "ttlSeconds": 1800, "billing": "request", "skip": "billing_request", "selfWarm": false } },
    { "name": "copilot, unknown model: no TTL", "provider": "github-copilot", "model": "gemini-3-pro", "isChild": false, "env": {}, "cfg": {},
      "expect": { "ttlSeconds": null, "billing": "request", "skip": "billing_request", "selfWarm": false } },
    { "name": "copilot, no model: no TTL", "provider": "github-copilot", "model": null, "isChild": false, "env": {}, "cfg": {},
      "expect": { "ttlSeconds": null, "billing": "request", "skip": "billing_request", "selfWarm": false } },
    { "name": "copilot, explicit ttlSeconds wins over the built-in row", "provider": "github-copilot", "model": "gpt-5.1", "isChild": false, "env": {},
      "cfg": { "providers": { "github-copilot": { "cache": { "ttlSeconds": 120 } } } },
      "expect": { "ttlSeconds": 120, "billing": "request", "skip": "billing_request", "selfWarm": false } },
    { "name": "copilot, byModel row wins over the built-in row", "provider": "github-copilot", "model": "gpt-5.1", "isChild": false, "env": {},
      "cfg": { "providers": { "github-copilot": { "cache": { "byModel": [{ "match": "gpt-*", "ttlSeconds": 600 }] } } } },
      "expect": { "ttlSeconds": 600, "billing": "request", "skip": "billing_request", "selfWarm": false } },
    { "name": "copilot, keep-alive enabled true never warms", "provider": "github-copilot", "model": "gpt-5.1", "isChild": false, "env": {},
      "cfg": { "providers": { "github-copilot": { "cache": { "keepalive": { "enabled": true } } } } },
      "expect": { "ttlSeconds": 1800, "billing": "request", "skip": "billing_request", "selfWarm": false } },
    { "name": "other provider without an entry", "provider": "someone-else", "model": "claude-opus-5-5", "isChild": false, "env": {}, "cfg": {},
      "expect": { "ttlSeconds": null, "billing": null, "skip": "no_entry", "selfWarm": false } },
    { "name": "other provider: the derived bridge TTL does not apply", "provider": "someone-else", "model": "m", "isChild": false, "env": {},
      "cfg": { "providers": { "someone-else": { "cache": { "billing": "token" } } } },
      "expect": { "ttlSeconds": null, "billing": "token", "skip": "ttl_unknown", "selfWarm": false } }
  ]
}
