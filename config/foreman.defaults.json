{
  "version": 1,
  "displayNames": "classic",
  "displayPresets": {
    "classic": {
      "foreman": "Picard",
      "planner": "Hannibal",
      "explorer": "Dora",
      "builder": "Bob",
      "reviewer": "Watson",
      "senior-reviewer": "Sherlock",
      "finalizer": "Gandalf"
    },
    "plain": {
      "foreman": "foreman",
      "planner": "planner",
      "explorer": "explorer",
      "builder": "builder",
      "reviewer": "reviewer",
      "senior-reviewer": "senior-reviewer",
      "finalizer": "finalizer"
    }
  },
  "roles": {
    "foreman": { "tools": [], "skills": [], "codemode": true },
    "session-foreman": { "tools": [], "skills": [], "codemode": false },
    "planner": { "tools": ["read", "ls", "grep", "find", "write", "edit"], "skills": [], "denyTools": ["mcp__*"], "codemode": false, "launch": "detached", "timeoutMinutes": 20 },
    "explorer": { "tools": ["read", "ls", "grep", "find", "bash"], "skills": [], "denyTools": ["mcp__*"], "codemode": true, "launch": "detached", "timeoutMinutes": 20, "strongAbove": 200000 },
    "builder": { "tools": ["read", "ls", "grep", "find", "bash", "edit", "write", "foreman_move", "foreman_copy"], "skills": [], "codemode": false, "launch": "detached", "timeoutMinutes": 60 },
    "reviewer": { "tools": ["read", "ls", "grep", "find", "bash"], "skills": [], "denyTools": ["mcp__*"], "codemode": false, "launch": "detached", "timeoutMinutes": 30 },
    "senior-reviewer": { "tools": ["read", "ls", "grep", "find", "bash"], "skills": [], "denyTools": ["mcp__*"], "codemode": false, "launch": "detached", "timeoutMinutes": 45 },
    "finalizer": { "tools": ["read", "ls", "grep", "find", "bash", "edit"], "skills": [], "codemode": false, "launch": "detached", "timeoutMinutes": 30 }
  },
  "providers": {},
  "fanout": { "max": 3 },
  "ladder": { "strongAbove": 100000, "childMaxTurns": 60, "maxTurns": { "builder": 100 }, "strongOnRevision": true, "reviewerClimb": { "enabled": false }, "research": { "factCriticalRung": null }, "reviewPanel": { "shadows": [], "gates": ["pre-pr"], "visible": true, "waitSeconds": 600 } },
  "maxThinking": "high",
  "quiet": false,
  "ceremony": {
    "default": "standard",
    "heavySignals": ["delete", "migration", "safety", "auth", "ci", "release", "public-api"],
    "heavyFileCount": 8,
    "overrides": {},
    "revisionRounds": { "standard": 1, "heavy": 2 },
    "requireTriage": true,
    "trivialBound": { "files": 2, "lines": 40, "newFiles": 0 },
    "required": { "trivial": ["builder"], "standard": ["builder", "reviewer"], "heavy": ["planner", "builder", "reviewer", "finalizer"] },
    "foremanEdits": "scratchpad",
    "scratchDir": ".workflow/scratch",
    "reviewBeforePr": true,
    "foremanReads": { "before": { "warn": 8, "every": 8 }, "after": { "warn": 8, "every": 8 } },
    "childReads": { "builder": { "warn": 20, "deny": 40 }, "reviewer": { "warn": 15, "deny": 30 } },
    "childScratch": { "keep": false },
    "recheckBudget": 3,
    "launchWait": "detach", "childBashTimeoutSeconds": 600, "childBashTimeoutMaxSeconds": 1800,
    "dedupeNotify": true,
    "reviewGate": "pass",
    "orientation": { "enabled": true, "maxLines": 120 },
    "ledgerHelper": "tool",
    "reviewPerRevision": true,
    "reviewRuns": 3,
    "budgetUsd": null,
    "reviewModel": null,
    "reviewByOccasion": {},
    "planReview": { "trivial": false, "standard": false, "heavy": true },
    "planReviewRounds": 2,
    "planner": "self",
    "childTimeoutSeconds": 1800,
    "launchTimeoutCapMinutes": 120,
    "heavyThreshold": "strict"
  },
  "review": {
    "headless": false,
    "childDefer": "deny",
    "critic": [
      "(1) Is this lean — how would Claude Code solve it, and is a deterministic rule, a classifier rule or a human the right layer?",
      "(2) Real repeated friction or a reviewer-invented edge case?",
      "(3) Code or config we would not miss? (an item failing this is dropped, not built)",
      "(4) Does it move toward the Pi top-chair switch?"
    ]
  },
  "sync": { "repos": [], "runRetro": true },
  "radar": { "doneTtlMinutes": 30, "recentRunSeconds": 8 },
  "retro": { "proposalMinReviews": 5, "enabled": null, "workspaceKey": null, "backlogDir": null, "repoBacklog": [], "expireDays": 14, "askThreshold": 2, "panelThreshold": 3 },
  "intercom": { "allowRemote": false, "allowOpenPane": false },
  "close": { "from": ["herdr", "intercom-parent"], "autoClean": true, "worktreeDir": "../<repo>.worktrees", "childWaitMs": 60000 },
  "footer": { "usage": true },
  "widget": { "children": true },
  "ui": { "symbols": "unicode", "spinner": true },
  "herdr": { "blockedShim": true, "groupTag": true },
  "compaction": {
    "priceTiers": { "cheap": 1, "standard": 5 },
    "threshold": { "cheap": 0.85, "standard": 0.75, "premium": 0.6 }
  },
  "wait": { "batchWindowSeconds": 300, "maxSeconds": 86400, "maxActive": 8, "ci": true },
  "resources": { "maxLoadPerCore": 1.5, "minFreeMemMB": 1024, "minFreeDiskGB": 5, "sampleSeconds": 30 },
  "paths": { "hubWorkflow": [] },
  "safety": {
    "permissions": { "allow": [], "ask": [], "deny": [], "paths": { "deny": [], "ask": [] }, "projectCommands": [], "readRoots": [], "autoReview": { "enabled": true, "rulesFile": null } },
    "requiredChildExtensions": [],
    "children": { "mayPush": false },
    "review": { "required": false },
    "git": {
      "protectedBranches": ["main", "master"],
      "commit": {
        "messagePattern": "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\\([A-Za-z0-9._/-]+\\))?!?: \\S|^merge: \\S",
        "requiredTrailers": [],
        "forbiddenTrailers": [],
        "checkCommand": null
      }
    },
    "ops": {
      "copyMaxBytes": 104857600,
      "worktreeDisposable": ["node_modules/", "target/", "dist/", "build/", "__pycache__/", ".venv/"],
      "baseBranch": null
    },
    "subagents": { "allowWorkflow": false }
  },
  "bridge": { "isolateClaudeConfig": "auto" },
  "python": { "path": null },
  "trace": { "enabled": null, "dir": null },
  "tools": { "git": false, "pr": true, "prHost": "auto", "prWatchSeconds": 60 }
}
