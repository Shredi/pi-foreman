{
  "version": 1,
  "profile": null,
  "displayNames": "classic",
  "presence": { "enabled": true, "awayAfterMinutes": 11 },
  "displayPresets": {
    "classic": {
      "foreman": "Picard",
      "explorer": "Dora",
      "builder": "Bob",
      "reviewer": "Watson"
    },
    "plain": {
      "foreman": "foreman",
      "explorer": "explorer",
      "builder": "builder",
      "reviewer": "reviewer"
    }
  },
  "roles": {
    "foreman": { "tools": [], "skills": [], "codemode": true },
    "session-foreman": { "tools": [], "skills": [], "codemode": false },
    "explorer": { "tools": ["read", "ls", "grep", "find", "bash"], "skills": [], "denyTools": ["mcp__*"], "codemode": true, "launch": "detached", "timeoutMinutes": 20, "strongAbove": 200000 },
    "builder": { "tools": ["read", "ls", "grep", "find", "bash", "edit", "write", "foreman_move", "foreman_copy"], "skills": [], "codemode": false, "launch": "detached", "timeoutMinutes": 60 },
    "reviewer": { "tools": ["read", "ls", "grep", "find", "bash"], "skills": ["security-review"], "denyTools": ["mcp__*"], "codemode": false, "launch": "detached", "timeoutMinutes": 30 }
  },
  "providers": {},
  "fanout": { "max": 3 },
  "ladder": { "strongAbove": 100000, "childMaxTurns": 60, "maxTurns": { "builder": 100 }, "strongOnRevision": true, "sizing": { "enabled": true, "largeFileLines": 1500, "maxModules": 2, "strongRisks": ["guard", "permission", "parser", "concurrency", "security"], "topRisks": ["design"], "topRung": null }, "reviewerClimb": { "enabled": false }, "idleDownshift": { "enabled": true, "causes": ["child", "wake", "intercom", "other"] }, "research": { "factCriticalRung": null }, "reviewPanel": { "shadows": [], "gates": ["pre-pr"], "visible": true, "waitSeconds": 600 } },
  "maxThinking": "high",
  "quiet": false,
  "ceremony": {
    "default": "standard",
    "heavySignals": ["delete", "migration", "safety", "auth", "ci", "release", "public-api"],
    "heavyFileCount": 8,
    "overrides": {},
    "revisionRounds": { "standard": 1, "heavy": 2 },
    "requireTriage": true,
    "trivialBound": { "files": 2, "lines": 40, "newFiles": 0 },
    "required": { "trivial": ["builder"], "standard": ["builder", "reviewer"], "heavy": ["builder", "reviewer"] },
    "foremanEdits": "scratchpad",
    "scratchDir": ".workflow/scratch",
    "reviewBeforePr": true,
    "foremanReads": { "before": { "warn": 8, "every": 8 }, "after": { "warn": 8, "every": 8 } },
    "childReads": { "builder": { "warn": 20, "deny": 40, "perFile": 5, "max": 120 }, "reviewer": { "warn": 15, "deny": 30, "perFile": 2, "max": 120 } },
    "childScratch": { "keep": false },
    "planReviewMax": 4,
    "recheckBudget": 3,
    "launchWait": "detach", "childBashTimeoutSeconds": 600, "childBashTimeoutMaxSeconds": 1800,
    "dedupeNotify": true,
    "reviewGate": "pass",
    "orientation": { "enabled": true, "maxLines": 120 },
    "ledgerHelper": "tool",
    "reviewPerRevision": true,
    "reviewRuns": 3,
    "budgetUsd": null,
    "reviewModel": null,
    "reviewByOccasion": {},
    "planReview": { "trivial": false, "standard": false, "heavy": true },
    "planReviewRounds": 2,
    "childTimeoutSeconds": 1800,
    "launchTimeoutCapMinutes": 120,
    "heavyThreshold": "strict"
  },
  "review": {
    "critic": [
      "(1) Is this lean — how would Claude Code solve it, and is a deterministic rule, a classifier rule or a human the right layer?",
      "(2) Real repeated friction or a reviewer-invented edge case?",
      "(3) Code or config we would not miss? (an item failing this is dropped, not built)",
      "(4) Does it move toward the Pi top-chair switch?"
    ]
  },
  "sync": { "repos": [], "runRetro": true },
  "radar": { "doneTtlMinutes": 30, "recentRunSeconds": 8, "openPrs": { "enabled": false, "refreshSeconds": 900, "mine": true, "authors": [], "scope": [] } },
  "retro": { "proposalMinReviews": 5, "enabled": null, "workspaceKey": null, "backlogDir": null, "repoBacklog": [], "expireDays": 14, "askThreshold": 2, "panelThreshold": 3 },
  "intercom": { "allowRemote": false, "allowOpenPane": false },
  "close": { "from": ["herdr", "intercom-parent", "remote-parent"], "autoClean": true, "worktreeDir": "../<repo>.worktrees", "childWaitMs": 60000 },
  "footer": { "usage": true, "style": "foreman", "cacheBar": true },
  "widget": { "children": true, "prs": true, "prLinks": true },
  "ui": { "symbols": "unicode", "spinner": true },
  "herdr": { "blockedShim": true, "groupTag": true },
  "sessions": { "backend": "auto", "hc": { "outliveParent": true }, "machines": {}, "remoteInlineMaxBytes": 32768, "pull": { "intervalSeconds": 20, "fastSeconds": 5 }, "ssh": { "controlMaster": true } },
  "compaction": { "maxTokens": 200000 },
  "wait": { "batchWindowSeconds": 300, "maxSeconds": 86400, "maxActive": 8, "ci": true },
  "resources": { "maxLoadPerCore": 1.5, "minFreeMemMB": 1024, "minFreeDiskGB": 5, "sampleSeconds": 30 },
  "paths": { "hubWorkflow": [] },
  "gate": { "reviewTimeoutMs": 15000, "askTimeoutMs": 900000, "childAsk": "parent", "tmpAccess": true, "logMaxBytes": 20971520 },
  "safety": {
    "policy": { "files": [] },
    "preBash": { "hooks": [], "strict": false },
    "requiredChildExtensions": [],
    "children": { "mayPush": false },
    "review": { "required": false },
    "git": {
      "protectedBranches": ["main", "master"],
      "commit": {
        "messagePattern": "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\\([A-Za-z0-9._/-]+\\))?!?: \\S|^merge: \\S",
        "requiredTrailers": [],
        "forbiddenTrailers": [],
        "checkCommand": null
      }
    },
    "ops": {
      "copyMaxBytes": 104857600,
      "worktreeDisposable": ["node_modules/", "target/", "dist/", "build/", "__pycache__/", ".venv/"],
      "baseBranch": null
    },
    "subagents": { "allowWorkflow": false }
  },
  "bridge": { "isolateClaudeConfig": "auto", "promptCacheTtl": { "main": "1h", "subagent": "5m" } },
  "python": { "path": null },
  "trace": { "enabled": null, "dir": null },
  "tools": { "git": false, "pr": true, "prHost": "auto", "prDots": true, "prWatchSeconds": 60, "prInteractions": [], "prShared": { "enabled": false, "authors": [], "seconds": 180, "events": true } },
  "sidebar": { "statusSeconds": 60 }
}
