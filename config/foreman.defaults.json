{
  "version": 1,
  "displayNames": "classic",
  "displayPresets": {
    "classic": {
      "foreman": "Picard",
      "planner": "Hannibal",
      "explorer": "Dora",
      "builder": "Bob",
      "reviewer": "Watson",
      "senior-reviewer": "Sherlock",
      "finalizer": "Gandalf"
    },
    "plain": {
      "foreman": "foreman",
      "planner": "planner",
      "explorer": "explorer",
      "builder": "builder",
      "reviewer": "reviewer",
      "senior-reviewer": "senior-reviewer",
      "finalizer": "finalizer"
    }
  },
  "roles": {
    "foreman": { "tools": [], "codemode": true },
    "planner": { "tools": ["read", "ls", "grep", "find", "write", "edit"], "codemode": false, "launch": "detached", "timeoutMinutes": 20 },
    "explorer": { "tools": ["read", "ls", "grep", "find", "bash"], "codemode": true, "launch": "detached", "timeoutMinutes": 20 },
    "builder": { "tools": ["read", "ls", "grep", "find", "bash", "edit", "write", "foreman_move", "foreman_copy"], "codemode": false, "launch": "detached", "timeoutMinutes": 60 },
    "reviewer": { "tools": ["read", "ls", "grep", "find", "bash"], "codemode": false, "launch": "detached", "timeoutMinutes": 30 },
    "senior-reviewer": { "tools": ["read", "ls", "grep", "find", "bash"], "codemode": false, "launch": "detached", "timeoutMinutes": 45 },
    "finalizer": { "tools": ["read", "ls", "grep", "find", "bash", "edit"], "codemode": false, "launch": "detached", "timeoutMinutes": 30 }
  },
  "providers": {},
  "fanout": { "max": 3 },
  "ladder": { "strongAbove": 100000, "childMaxTurns": 60, "strongOnRevision": true },
  "maxThinking": "high",
  "ceremony": {
    "default": "standard",
    "heavySignals": ["delete", "migration", "safety", "auth", "ci", "release", "public-api"],
    "heavyFileCount": 8,
    "overrides": {},
    "revisionRounds": { "standard": 1, "heavy": 2 },
    "requireTriage": true,
    "trivialBound": { "files": 2, "lines": 40, "newFiles": 0 },
    "required": { "trivial": ["builder"], "standard": ["builder", "reviewer"], "heavy": ["planner", "builder", "reviewer", "finalizer"] },
    "foremanEdits": "scratchpad",
    "scratchDir": ".workflow/scratch",
    "reviewBeforePr": true,
    "foremanReads": { "before": { "warn": 4, "deny": 8 }, "after": { "warn": 4, "deny": 8 } },
    "childReads": { "builder": { "warn": 20, "deny": 40 }, "reviewer": { "warn": 15, "deny": 30 } },
    "recheckBudget": 3,
    "launchWait": "block",
    "dedupeNotify": true,
    "reviewGate": "pass",
    "orientation": { "enabled": true, "maxLines": 120 },
    "ledgerHelper": "tool",
    "reviewPerRevision": true,
    "heavyThreshold": "strict"
  },
  "review": { "headless": false },
  "sync": { "repos": [], "runRetro": true },
  "retro": { "proposalMinReviews": 5 },
  "intercom": { "allowRemote": false, "allowOpenPane": false },
  "close": { "from": ["herdr", "intercom-parent"] },
  "footer": { "usage": true },
  "herdr": { "blockedShim": true, "groupTag": true },
  "compaction": {
    "priceTiers": { "cheap": 1, "standard": 5 },
    "threshold": { "cheap": 0.85, "standard": 0.75, "premium": 0.6 }
  },
  "wait": { "batchWindowSeconds": 300, "maxSeconds": 86400, "maxActive": 8, "ci": true },
  "safety": {
    "permissions": { "allow": [], "ask": [], "deny": [], "paths": { "deny": [], "ask": [] }, "projectCommands": [] },
    "requiredChildExtensions": [],
    "children": { "mayPush": false },
    "review": { "required": false },
    "git": {
      "protectedBranches": ["main", "master"],
      "commit": {
        "messagePattern": "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\\([A-Za-z0-9._/-]+\\))?!?: \\S|^merge: \\S",
        "requiredTrailers": [],
        "forbiddenTrailers": [],
        "checkCommand": null
      }
    },
    "ops": {
      "copyMaxBytes": 104857600,
      "worktreeDisposable": ["node_modules/", "target/", "dist/", "build/", "__pycache__/", ".venv/"],
      "baseBranch": null
    },
    "subagents": { "allowWorkflow": false }
  },
  "bridge": { "isolateClaudeConfig": "auto" },
  "python": { "path": null },
  "trace": { "enabled": false, "dir": null }
}
