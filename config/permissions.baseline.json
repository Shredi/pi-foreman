{
  "version": 1,
  "comment": "L1 baseline for the permission rules (design section 5). Patterns use the wildcard syntax of @gotgenes/pi-permission-system: * matches any characters including /, ? one character, a trailing ' *' also matches the bare command. {agentDir} is replaced by the Pi agent dir. The codemode tool is deliberately NOT allowlisted: inner calls are gated individually, codemode itself stays at the default. Layers add to these lists through safety.permissions in foreman.json; nothing below can be removed by a layer.",
  "tools": {
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "subagent": "allow",
    "subagent_supervisor": "allow",
    "foreman_worktree_remove": "allow",
    "foreman_move": "allow",
    "foreman_copy": "allow",
    "foreman_triage": "allow",
    "foreman_wait": "allow"
  },
  "externalDirectory": "ask",
  "shellTools": {
    "powershell": {
      "commandArgument": "command"
    }
  },
  "bash": {
    "allow": [
      "git status *",
      "git diff *",
      "git log *",
      "git show *",
      "git blame *",
      "git rev-parse *",
      "git ls-files *",
      "git branch",
      "git branch -a",
      "git branch -r",
      "git branch -v",
      "git branch -vv",
      "git branch --list *",
      "git branch --show-current",
      "git worktree list *",
      "git stash list *",
      "ls *",
      "tree *",
      "pwd",
      "cat *",
      "head *",
      "tail *",
      "wc *",
      "rg *",
      "grep *",
      "find *",
      "stat *",
      "file *",
      "diff *",
      "which *",
      "echo *",
      "npm test *",
      "npm run test *",
      "npm run build *",
      "node --test *",
      "python -m unittest *",
      "python3 -m unittest *",
      "pytest *",
      "ledger status *",
      "ledger mark *",
      "ledger add *",
      "ledger note *"
    ],
    "ask": [
      "find * -exec*",
      "find * -execdir*",
      "find * -delete*",
      "Remove-Item * -R*",
      "remove-item * -r*",
      "ri *",
      "rd /s*",
      "rmdir /s*",
      "del /s*"
    ],
    "deny": [
      "sudo *",
      "doas *",
      "curl * | sh *",
      "curl * | bash *",
      "curl * | zsh *",
      "curl * | sudo *",
      "wget * | sh *",
      "wget * | bash *",
      "wget * | zsh *",
      "wget * | sudo *",
      "gh auth token*",
      "gh auth status --show-token*",
      "git credential fill*",
      "security find-generic-password* -w*",
      "security find-generic-password* -g*",
      "security find-internet-password*"
    ]
  },
  "paths": {
    "deny": [
      "*.env",
      "*.env.*",
      "*/.ssh/*",
      "*.pem",
      "*.key",
      "*/credentials",
      "*/credentials.*",
      "~/.aws/*",
      "{agentDir}/auth.json",
      "{agentDir}/extensions/pi-permission-system/*",
      "*/.pi/extensions/pi-permission-system/*",
      "~/.git-credentials",
      "~/.config/gh/*",
      "~/.netrc",
      "~/_netrc",
      "~/.npmrc",
      "~/.pypirc",
      "~/.docker/config.json",
      "~/.kube/config",
      "~/.config/hub",
      "~/.config/glab-cli/*"
    ],
    "except": [
      "*.env.example",
      "*.env.sample",
      "*.env.template"
    ]
  },
  "protect": {
    "comment": "Write protection, enforced by the adapter overlay only (the permission system's path rules cannot tell a read from a write). Each pattern is checked against the path of write/edit, the destination (and a moved source) of foreman_move/foreman_copy and, except writeAsk, every path word of a shell command. deny: every session. ask: the foreman is asked, children are denied. childDeny: children only. removeAsk: like ask, but only for a remove or rename of the path itself (rm, rmdir, trash, mv, Remove-Item and the like, inline code of python -c/node -e, the moved source of foreman_move); reading or listing it stays allowed. writeAsk: like ask, but shell words are checked in children only (the foreman's shell may read and run the package). {cwd} is the session cwd, {agentDirParent} the agent dir's parent folder (~/.pi by default), {pkgRoot} the pi-foreman package root. {xdgConfigHome} is $XDG_CONFIG_HOME (patterns using it are dropped when it is unset). CLAUDE.md is not protected: claude-bridge excludes CLAUDE.md and .claude/rules from its turns (claudeMdExcludes), so it is ordinary project text.",
    "deny": [
      "*/.git",
      "*/.git/*"
    ],
    "ask": [
      "{cwd}/.pi",
      "{cwd}/.pi/*",
      "{cwd}/.pi/claude-bridge.json",
      "{cwd}/.agents",
      "{cwd}/.agents/*",
      "{agentDir}/foreman.json",
      "{agentDir}/settings.json",
      "{agentDir}/claude-bridge.json",
      "{agentDir}/agents",
      "{agentDir}/agents/*",
      "{agentDir}/npm",
      "{agentDir}/npm/*",
      "{agentDir}/extensions",
      "{agentDir}/extensions/*",
      "{cwd}/.claude",
      "{cwd}/.claude/*",
      "{cwd}/.mcp.json",
      "{agentDir}/pi-foreman/claude-config",
      "{agentDir}/pi-foreman/claude-config/*",
      "{agentDir}/pi-foreman/state",
      "{agentDir}/pi-foreman/state/*",
      "~/.claude",
      "~/.claude/*",
      "~/.gitconfig",
      "~/.config/git",
      "~/.config/git/*",
      "{xdgConfigHome}/git",
      "{xdgConfigHome}/git/*"
    ],
    "childDeny": [
      "*/.pi/agents",
      "*/.pi/agents/*",
      "*/.pi/settings.json",
      "*/.pi/foreman.json",
      "*/.pi/claude-bridge.json",
      "*/.pi/extensions/*",
      "*/.pi/npm/*",
      "*/.agents",
      "*/.agents/*"
    ],
    "removeAsk": [
      "{agentDirParent}",
      "{agentDir}",
      "{agentDir}/pi-foreman"
    ],
    "writeAsk": [
      "{pkgRoot}",
      "{pkgRoot}/*"
    ]
  }
}
