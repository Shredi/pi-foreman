{
  "name": "pi-foreman",
  "version": "0.0.0",
  "description": "Orchestration harness for the pi coding agent: foreman session, five subagent roles, ledger, guards.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./extensions/core-adapter/index.ts",
      "./node_modules/pi-subagents/index.js",
      "./node_modules/@gotgenes/pi-permission-system/src/index.ts",
      "./node_modules/pi-intercom/index.ts"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    },
    "skills": [
      "./node_modules/pi-subagents/skills",
      "./node_modules/pi-intercom/skills",
      "./skills"
    ],
    "prompts": [
      "./node_modules/pi-subagents/prompts"
    ]
  },
  "scripts": {
    "test": "python -m unittest discover -s tests -v",
    "test:node": "node --import ./extensions/core-adapter/test/_hermetic-env.mjs --test \"extensions/core-adapter/test/*.test.ts\" \"extensions/core-adapter/test/retired/*.test.ts\"",
    "test:installer": "node --test \"tests/installer/*.test.mjs\"",
    "test:ci": "node scripts/foreman_ci.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module",
  "dependencies": {
    "@gotgenes/pi-permission-system": "39.0.2",
    "pi-intercom": "0.17.0",
    "pi-subagents": "0.78.0",
    "unbash": "6.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
