{
  "name": "pi-foreman",
  "version": "0.0.0",
  "description": "Orchestration harness for the pi coding agent: foreman session, five subagent roles, ledger, guards.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19",
    "npm": "<11.9.0 || >=11.13.0"
  },
  "pi": {
    "extensions": [
      "./extensions/core-adapter/index.ts",
      "./node_modules/pi-background-tasks/dist/extensions/anthropic-attribution.js",
      "./node_modules/pi-background-tasks/dist/extensions/background-tasks.js",
      "./node_modules/pi-subagents/index.js",
      "./node_modules/pi-intercom/index.ts",
      "./node_modules/@juicesharp/rpiv-ask-user-question/index.ts"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    },
    "skills": [
      "./node_modules/pi-subagents/skills",
      "./node_modules/pi-intercom/skills",
      "./skills"
    ],
    "prompts": [
      "./node_modules/pi-subagents/prompts"
    ]
  },
  "scripts": {
    "test": "node scripts/foreman_test_run.mjs --exec -- python -m unittest discover -s tests -v",
    "test:gate-sweep": "node scripts/gate_sweep.mjs",
    "test:node": "node scripts/foreman_test_run.mjs --import ./extensions/core-adapter/test/_hermetic-env.mjs \"extensions/core-adapter/test/*.test.ts\" \"extensions/core-adapter/test/retired/*.test.ts\" \"integrations/herdr-app/pi-foreman/*.test.mjs\" \"integrations/herdr-app/pi-foreman-plan/*.test.mjs\"",
    "test:installer": "node --import ./tests/installer/_hermetic-env.mjs --test \"tests/installer/*.test.mjs\"",
    "test:ci": "node scripts/foreman_ci.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:ts": "oxlint --type-aware --deny-warnings extensions setup"
  },
  "type": "module",
  "dependencies": {
    "@inquirer/prompts": "8.8.1",
    "@juicesharp/rpiv-ask-user-question": "git+https://github.com/Shredi/rpiv-ask-user-question.git#62ad77de8ba3b7dc1b407bfab7be4fac8a69fa41",
    "pi-background-tasks": "2.6.10",
    "pi-intercom": "git+https://github.com/Shredi/pi-intercom.git#c623a082dbf93575f57d99b6656cc96fd89c7227",
    "pi-subagents": "0.90.0",
    "unbash": "6.0.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.7.0",
    "@earendil-works/pi-tui": "1.7.0",
    "@types/node": "^22.0.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "^5.9.0"
  },
  "optionalDependencies": {
    "beautiful-mermaid": "1.1.3"
  }
}
