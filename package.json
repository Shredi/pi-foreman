{
  "name": "pi-foreman",
  "version": "0.0.0",
  "description": "Orchestration harness for the pi coding agent: foreman session, five subagent roles, ledger, guards.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./extensions/core-adapter/index.ts",
      "./node_modules/pi-subagents/index.js",
      "./node_modules/pi-intercom/index.ts",
      "./node_modules/@juicesharp/rpiv-ask-user-question/index.ts"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    },
    "skills": [
      "./node_modules/pi-subagents/skills",
      "./node_modules/pi-intercom/skills",
      "./skills"
    ],
    "prompts": [
      "./node_modules/pi-subagents/prompts"
    ]
  },
  "scripts": {
    "test": "node scripts/foreman_test_run.mjs --exec -- python -m unittest discover -s tests -v",
    "test:node": "node scripts/foreman_test_run.mjs --import ./extensions/core-adapter/test/_hermetic-env.mjs \"extensions/core-adapter/test/*.test.ts\" \"extensions/core-adapter/test/retired/*.test.ts\" \"integrations/herdr-app/pi-foreman/*.test.mjs\" \"integrations/herdr-app/pi-foreman-plan/*.test.mjs\"",
    "test:installer": "node --test \"tests/installer/*.test.mjs\"",
    "test:ci": "node scripts/foreman_ci.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module",
  "dependencies": {
    "@inquirer/prompts": "8.7.4",
    "@juicesharp/rpiv-ask-user-question": "2.15.0",
    "pi-intercom": "git+https://github.com/Shredi/pi-intercom.git#5f184cce7e2811a130dc44ebac745db7562a1543",
    "pi-subagents": "0.78.0",
    "unbash": "6.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.1",
    "@earendil-works/pi-tui": "1.5.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "optionalDependencies": {
    "beautiful-mermaid": "1.1.3"
  }
}
