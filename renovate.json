{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "pin",
  "automerge": false,
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "groupName": "pi packages",
      "matchPackageNames": [
        "pi-subagents",
        "pi-intercom",
        "@mariozechner/*",
        "@earendil-works/*"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": ["pi-intercom"],
      "enabled": false,
      "description": "pi-intercom is a fork pin (git+https spec) carrying the hc transport; updates are taken by rebasing the fork, see docs/install.md. Remove this rule when pi-foreman returns to upstream."
    },
    {
      "groupName": "npm devDependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": ["*", "!@earendil-works/*"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "packages.lock.json pins (bump together with package.json; installer test requires equal pins)",
      "managerFilePatterns": ["/(^|/)packages\\.lock\\.json$/"],
      "matchStrings": ["\"name\": \"(?<depName>[^\"]+)\",\\s*\"version\": \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "npm"
    }
  ]
}
