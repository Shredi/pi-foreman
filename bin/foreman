#!/bin/sh
# pi-foreman: `foreman setup|update-check|retro|sync|session|radar|config|bench|backlog|findings|close|worktree|dialogs [args]` -> scripts/foreman_<name>.py.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
sub="${1:-}"
if [ "$sub" = "setup" ]; then
    shift
    exec node "$here/../setup.mjs" "$@"
fi
if [ "$sub" = "dialogs" ]; then
    shift
    if ! node -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>22||(a===22&&b>=6)?0:1)' 2>/dev/null; then
        echo "foreman dialogs needs Node >= 22.6 (--experimental-strip-types)" >&2
        exit 1
    fi
    exec node --no-warnings --experimental-strip-types "$here/../extensions/core-adapter/dialogs-cli.ts" "$@"
fi
case "$sub" in
    update-check) script="$here/../scripts/foreman_update_check.py" ;;
    retro) script="$here/../scripts/foreman_retro.py" ;;
    sync) script="$here/../scripts/foreman_sync.py" ;;
    session) script="$here/../scripts/foreman_session.py" ;;
    radar) script="$here/../scripts/foreman_radar.py" ;;
    config) script="$here/../scripts/foreman_config.py" ;;
    bench) script="$here/../scripts/foreman_bench.py" ;;
    backlog) script="$here/../scripts/foreman_backlog.py" ;;
    findings) script="$here/../scripts/foreman_findings.py" ;;
    close) script="$here/../scripts/foreman_close.py" ;;
    worktree) script="$here/../scripts/foreman_worktree.py" ;;
    *) echo "usage: foreman setup|update-check|retro|sync|session|radar|config|bench|backlog|findings|close|worktree|dialogs [args]" >&2; exit 2 ;;
esac
shift
py="${PI_FOREMAN_PYTHON:-}"
if [ -z "$py" ]; then
    if command -v python3 >/dev/null 2>&1; then py=python3; else py=python; fi
fi
exec "$py" -E -s "$script" "$@"
