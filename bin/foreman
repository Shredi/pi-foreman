#!/bin/sh
# pi-foreman: `foreman setup|update-check|retro|sync|session|radar|config|bench|backlog|findings|close|worktree|dialogs|features|perms [args]` -> scripts/foreman_<name>.py (features, perms: .mjs).
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
sub="${1:-}"
if [ "$sub" = "setup" ]; then
    shift
    exec node "$here/../setup.mjs" "$@"
fi
if [ "$sub" = "dialogs" ]; then
    shift
    if ! node -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>22||(a===22&&b>=6)?0:1)' 2>/dev/null; then
        echo "foreman dialogs needs Node >= 22.6 (--experimental-strip-types)" >&2
        exit 1
    fi
    exec node --no-warnings --experimental-strip-types "$here/../extensions/core-adapter/dialogs-cli.ts" "$@"
fi
if [ "$sub" = "features" ]; then
    shift
    exec node "$here/../scripts/foreman_features.mjs" "$@"
fi
if [ "$sub" = "perms" ]; then
    shift
    exec node "$here/../scripts/foreman_perms.mjs" "$@"
fi
case "$sub" in
    update-check) script="$here/../scripts/foreman_update_check.py" ;;
    retro) script="$here/../scripts/foreman_retro.py" ;;
    sync) script="$here/../scripts/foreman_sync.py" ;;
    session) script="$here/../scripts/foreman_session.py" ;;
    radar) script="$here/../scripts/foreman_radar.py" ;;
    config) script="$here/../scripts/foreman_config.py" ;;
    bench) script="$here/../scripts/foreman_bench.py" ;;
    backlog) script="$here/../scripts/foreman_backlog.py" ;;
    findings) script="$here/../scripts/foreman_findings.py" ;;
    close) script="$here/../scripts/foreman_close.py" ;;
    worktree) script="$here/../scripts/foreman_worktree.py" ;;
    *) echo "usage: foreman setup|update-check|retro|sync|session|radar|config|bench|backlog|findings|close|worktree|dialogs|features|perms [args]" >&2; exit 2 ;;
esac
shift
py="${PI_FOREMAN_PYTHON:-}"
if [ -z "$py" ]; then
    found=none
    for c in python3 python3.14 python3.13 python; do
        command -v "$c" >/dev/null 2>&1 || continue
        if "$c" -c 'import sys; sys.exit(sys.version_info < (3, 13))' >/dev/null 2>&1; then py=$c; break; fi
        if [ "$found" = none ]; then found="$c $("$c" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)"; fi
    done
    if [ -z "$py" ]; then
        echo "pi-foreman needs Python 3.13+; found $found. Set PI_FOREMAN_PYTHON or install Python 3.13 (macOS: brew install python@3.13)." >&2
        exit 2
    fi
fi
exec "$py" -E -s "$script" "$@"
