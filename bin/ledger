#!/bin/sh
# pi-foreman: `ledger` for Pi's bash tool (the adapter prepends this bin/ to PATH).
# Runs the vendored core's ledger.py, bound to the same session as the guards:
#   PI_SESSION_ID        set by Pi for every shell command -> CLAUDE_CODE_SESSION_ID (what ledger.py reads)
#   PI_FOREMAN_STATE_DIR marker directory chosen by the adapter -> TMPDIR (where ledger.py looks)
#   PI_FOREMAN_PYTHON    interpreter the adapter resolved (fallback: the first Python 3.13+ of python3, python3.14, python3.13, python)
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
script="$here/../core/scripts/ledger.py"
py="${PI_FOREMAN_PYTHON:-}"
if [ -z "$py" ]; then
    found=none
    for c in python3 python3.14 python3.13 python; do
        command -v "$c" >/dev/null 2>&1 || continue
        if "$c" -c 'import sys; sys.exit(sys.version_info < (3, 13))' >/dev/null 2>&1; then py=$c; break; fi
        if [ "$found" = none ]; then found="$c $("$c" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)"; fi
    done
    if [ -z "$py" ]; then
        echo "pi-foreman needs Python 3.13+; found $found. Set PI_FOREMAN_PYTHON or install Python 3.13 (macOS: brew install python@3.13)." >&2
        exit 2
    fi
fi
if [ -n "${PI_SESSION_ID:-}" ]; then
    CLAUDE_CODE_SESSION_ID="$PI_SESSION_ID"
    export CLAUDE_CODE_SESSION_ID
else
    unset CLAUDE_CODE_SESSION_ID
fi
if [ -n "${PI_FOREMAN_STATE_DIR:-}" ]; then
    TMPDIR="$PI_FOREMAN_STATE_DIR"
    export TMPDIR
fi
exec "$py" -E -s "$script" "$@"
